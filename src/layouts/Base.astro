---
import { shop, buy, product } from '../config';
import '../styles.css';

interface Props {
  title?: string;
  description?: string;
  /** Header sits over the opening photo (home page only). */
  overlay?: boolean;
  /** The opening photo is present, so the header text turns light. */
  light?: boolean;
}

const {
  title,
  description = 'Extra virgin olive oil from my family’s olive trees on the north-west coast of Corfu, sent across the UK.',
  overlay = false,
  light = false,
} = Astro.props;
const fullTitle = title ? `${title} | ${shop.name}` : `${shop.name} | ${shop.tagline}`;
const path = Astro.url.pathname;
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#faf8f3" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@400;600&family=Instrument+Serif&display=swap" rel="stylesheet" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    {shop.christmas.open && (
      <p class="notice">Christmas orders: order by {shop.christmas.lastOrder}, dispatched {shop.christmas.dispatch}.</p>
    )}
    <div style={overlay ? 'position:relative' : undefined}>
      <header class:list={['site-header', { 'page-header': !overlay }]} style={light ? 'color:var(--ground)' : undefined}>
        <div class="wrap">
          <a href="/" class="wordmark">{shop.name}</a>
          <nav aria-label="Main">
            <a href="/#story" class="hide-sm">Our story</a>
            <a href="/delivery/" class="hide-sm" aria-current={path === '/delivery/' ? 'page' : undefined}>Delivery</a>
            <a class="btn btn-small" href={buy.one.url}>Order · £{product.price}</a>
          </nav>
        </div>
      </header>
      <main id="main">
        <slot />
      </main>
    </div>

    <footer class="site-footer">
      <div class="wrap">
        <div class="footer-grid">
          <span class="wordmark">{shop.name}</span>
          <nav aria-label="Shop information">
            <a href="/delivery/">Delivery</a>
            <a href="/returns/">Returns</a>
            <a href="/terms/">Terms</a>
            <a href="/privacy/">Privacy</a>
            <a href={`mailto:${shop.email}`}>{shop.email}</a>
            <a href={shop.instagram}>Instagram</a>
          </nav>
        </div>
        <p class="footer-legal">
          {shop.company.legalName}, registered in England and Wales, company number {shop.company.number}.
          Registered office: {shop.company.registeredOffice}.
        </p>
      </div>
    </footer>
  </body>
</html>
