---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import Fill from '../components/Fill.astro';
import Scene from '../components/Scene.astro';
import { photoFile } from '../photo-file';
import { shop, product, buy, postage } from '../config';

const heroPhoto = Boolean(photoFile('mum-in-the-grove'));
const xmas = shop.christmas.open;
---

<Base overlay light={heroPhoto}>
  <section class:list={['opening', { 'has-photo': heroPhoto }]} aria-labelledby="opening-title">
    <div class="opening-photo"><Photo name="mum-in-the-grove" ratio="auto" eager /></div>
    <div class="wrap opening-copy">
      <h1 id="opening-title">My family’s olive trees in Corfu</h1>
      <p>This is my mother, <Fill>[Mum’s name]</Fill>, in the grove she looks after.</p>
    </div>
  </section>

  <section id="story" class="wrap chapter" aria-labelledby="ch1">
    <div class="split">
      <div class="prose">
        <h2 id="ch1">Trees older than anyone can remember</h2>
        <p>Our olive trees grow above the sea near <Fill>[village]</Fill>, on the north-west tip of Corfu. Some of them have stood there for hundreds of years, and they have passed from one generation of our family to the next.</p>
        <p>From the grove you look out across the Ionian Sea to the Diapontian islands: Othonoi, Ereikoussa and Mathraki. That view gave the oil its name.</p>
      </div>
      <Photo name="old-trunk" ratio="4 / 5" />
    </div>
    <figure class="full-bleed" style="margin-left:0;margin-right:0">
      <Photo name="grove-and-islands" ratio="21 / 9" />
      <figcaption class="caption">The grove, and the Diapontian islands on the horizon.</figcaption>
    </figure>
  </section>

  <section class="wrap chapter" aria-labelledby="ch2">
    <div class="split flip">
      <div class="prose">
        <h2 id="ch2">She knows every tree</h2>
        <p><Fill>[Two or three true sentences about Mum: when she started working in the grove, who taught her, what she does there through the year.]</Fill></p>
        <blockquote class="quote">
          <p><Fill>“[Something Mum says about the trees, in her words.]”</Fill></p>
          <footer><Fill>[Mum’s name]</Fill>, in the grove</footer>
        </blockquote>
      </div>
      <Photo name="mum-hands" ratio="4 / 5" />
    </div>
  </section>

  <section class="wrap chapter" aria-labelledby="ch3">
    <div class="prose">
      <h2 id="ch3">Picked by the family, pressed on the island</h2>
      <p>Every <Fill>[harvest months]</Fill> the family lays nets under the trees and gathers the olives. They are pressed on the island, and an independent laboratory tests each batch. Only oil that passes as extra virgin goes into a Diapontia bottle.</p>
    </div>
    <div class="harvest">
      <Photo name="harvest-nets" ratio="3 / 2" />
      <div class="harvest-side">
        <Photo name="family-archive" ratio="4 / 3" />
      </div>
    </div>
  </section>

  <section class="wrap chapter" aria-labelledby="ch4">
    <div class="split">
      <div class="prose">
        <h2 id="ch4">Now, at yours</h2>
        <p>This oil has always been shared at our family’s table. This winter, for the first time, we have bottled a small batch of 100 bottles to share with you in the UK.</p>
        <div class="scene-line"><Scene uid="home" /></div>
      </div>
      <Photo name="at-the-table" ratio="4 / 5" />
    </div>
  </section>

  <section id="order" class="wrap shop" aria-labelledby="shop-title">
    <div class="shop-inner">
      <div class="shop-bottle">
        <img src="/brand/bottle.webp" width="402" height="1842" alt="A 750 ml bottle of Diapontia" />
      </div>
      <div>
        <h2 id="shop-title">Diapontia extra virgin olive oil</h2>
        <p class="price">£{product.price} <span class="small muted" style="font-family:var(--text)">{product.size}</span></p>
        <p class="muted">
          {xmas ? `Order by ${shop.christmas.lastOrder} and we dispatch ${shop.christmas.dispatch}.` : `Dispatched ${shop.normalDispatch}.`}
          {' '}Add a gift message at checkout and we write it by hand on a card in the box.
        </p>
        <div class="shop-actions">
          <a class="btn" href={buy.one.url}>Order a bottle · £{buy.one.price}</a>
          <a href={buy.two.url}>Or two as a gift, £{buy.two.price}</a>
        </div>
        <ul class="facts">
          <li>Extra virgin, lab tested every batch</li>
          <li>UK delivery from £{postage[0].price.toFixed(2)}, Royal Mail Tracked 48</li>
          <li>First batch of 100 bottles</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="wrap faq" aria-labelledby="faq-title">
    <h2 id="faq-title">Questions</h2>
    <div class="faq-list">
      <details>
        <summary>When will my order arrive?</summary>
        <p>{xmas ? `Christmas orders placed by ${shop.christmas.lastOrder} are dispatched ${shop.christmas.dispatch}. ` : ''}Otherwise we dispatch {shop.normalDispatch}. Royal Mail Tracked 48 usually delivers two to three working days later.</p>
      </details>
      <details>
        <summary>How do I know it is extra virgin?</summary>
        <p>An independent laboratory tests every batch before it is bottled. Email us and we will send you the result for your batch.</p>
      </details>
      <details>
        <summary>Can I send it straight to someone as a gift?</summary>
        <p>Yes. Enter their address at checkout and add a gift message. We write it by hand on a card in the box.</p>
      </details>
      <details>
        <summary>What if a bottle arrives broken?</summary>
        <p>Email us a photo within 7 days and we send a replacement or refund you in full.</p>
      </details>
    </div>
  </section>
</Base>
