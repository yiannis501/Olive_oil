---
import Base from '../layouts/Base.astro';
import { shop, product, buy, postage, waitlistUrl } from '../config';

const dispatchLine = shop.christmas.open
  ? `Christmas orders dispatched ${shop.christmas.dispatch}.`
  : `Dispatched ${shop.normalDispatch}.`;
---

<Base>
  <section class="wrap hero">
    <div class="hero-art">
      <!-- Swap for a real photo: put grove.jpg in /public and use <img src="/grove.jpg" alt="..." /> -->
      <img class="bottle" src="/bottle.svg" alt="A 750 ml bottle of Diapontia extra virgin olive oil" />
    </div>
    <div>
      <p class="eyebrow">Made in Corfu, Greece</p>
      <h1>Olive oil from our family's centuries-old trees</h1>
      <p class="lead">
        Diapontia is extra virgin olive oil from one family grove in north-west Corfu, looking out to
        the Diapontian islands. Pressed from our own olives, independently tested, and bottled in Greece.
      </p>
      <p class="price">£{product.price} <small>{product.size} bottle</small></p>
      <ul class="facts">
        <li>Extra virgin, lab tested for every batch</li>
        <li>One grove, one family, a small first batch of 100 bottles</li>
        <li>{dispatchLine} Postage from £{postage[0].price.toFixed(2)}.</li>
      </ul>
      <div class="buy">
        <a class="btn btn-primary" href={buy.one.url}>
          <span>Buy {buy.one.label}</span><span>£{buy.one.price}</span>
        </a>
        <a class="btn btn-secondary" href={buy.two.url}>
          <span>Buy {buy.two.label}</span><span>£{buy.two.price}</span>
        </a>
      </div>
      <p class="small">
        Secure checkout by Stripe. Add a gift message at checkout and we will handwrite it on a card in the box.
        UK delivery only.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="wrap grid-3">
      <div class="card">
        <h3>One grove in Corfu</h3>
        <p>Our trees have grown on the same hillside for hundreds of years. Every bottle comes from them and nowhere else.</p>
      </div>
      <div class="card">
        <h3>Tested, not just tasted</h3>
        <p>An independent laboratory tests each batch. Only oil that meets the extra virgin standard goes into a Diapontia bottle.</p>
      </div>
      <div class="card">
        <h3>A gift that gets used</h3>
        <p>A generous 750 ml bottle, packed by hand, with your message written on a card. Good for anyone who cooks.</p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap split">
      <div>
        <p class="eyebrow">Our story</p>
        <h2>Named after the islands we see from the grove</h2>
        <p>
          Othonoi, Ereikoussa and Mathraki, the Diapontian islands, sit off the north-west coast of Corfu.
          Our family has looked out at them from the olive grove for generations. Diapontia is our first
          bottling for friends and customers in the UK.
        </p>
        <p><a href="/story/">Read our story</a></p>
      </div>
      <!-- TODO: replace with a real line from the family -->
      <p class="quote">Hundreds of years old, the trees are still picked by our family every winter.</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap narrow" style="padding-top:0;padding-bottom:0">
      <h2>Delivery</h2>
      <table>
        <thead><tr><th>Order</th><th>Postage</th></tr></thead>
        <tbody>
          {postage.map((p) => <tr><td>{p.what}</td><td>£{p.price.toFixed(2)}</td></tr>)}
        </tbody>
      </table>
      <p>
        {shop.christmas.open
          ? `Order by ${shop.christmas.lastOrder} for Christmas. We dispatch Christmas orders ${shop.christmas.dispatch}.`
          : `We pack every order by hand and dispatch ${shop.normalDispatch}.`}
        {' '}<a href="/delivery/">Delivery details</a>
      </p>
      {waitlistUrl && (
        <p><a href={waitlistUrl}>Join the list</a> to hear when the next batch is ready.</p>
      )}
    </div>
  </section>
</Base>
